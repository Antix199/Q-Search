# Plantilla de credenciales. Copia este archivo como .env y completa los valores.
# El archivo .env real está en .gitignore y NO debe subirse al repositorio.

# QRydDemo (simulador de átomos de Rydberg) — para quantum_search_qryd.py
QRYD_API_TOKEN=

# IBM Quantum Platform (hardware real) — para quantum_search_ibm.py
# Canal moderno 'ibm_quantum_platform'. El token es la API key (~44 chars)
# y el CRN identifica la instancia del Open Plan.
IBM_QUANTUM_TOKEN=
IBM_QUANTUM_CRN=
