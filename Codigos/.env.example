# Plantilla de credenciales. Copia este archivo como .env y completa los valores.
# El archivo .env real está en .gitignore y NO debe subirse al repositorio.

# QRydDemo (simulador de átomos de Rydberg) — para quantum_search_qryd.py
QRYD_API_TOKEN=

# IQM Resonance (hardware real) — para quantum_search_iqm.py
# El token y el alias del dispositivo ("Quantum computer alias") se obtienen
# en el dashboard: https://resonance.iqm.tech/
IQM_TOKEN=
IQM_SERVER_URL=https://resonance.iqm.tech
IQM_DEVICE=emerald
